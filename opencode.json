{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "agent": {
    "compaction": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "low"
    }
  },
  "subagent_depth": 1,
  "permission": {
    "external_directory": {
      "*": "ask",
      "D:/ATLAS/**": "allow",
      "D:/ATLAS-worktrees/**": "allow",
      "E:/**": "allow",
      "D:/ATLAS-database-recovery/**": "allow",
      "D:/EnrollPro/**": "allow",
      "D:/AIMS/**": "allow",
      "D:/smart-final-capstone/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "D:/ATLAS/**": "allow",
      "D:/ATLAS-worktrees/**": "allow",
      "E:/**": "allow",
      "D:/ATLAS-database-recovery/**": "deny",
      "D:/EnrollPro/**": "deny",
      "D:/AIMS/**": "deny",
      "D:/smart-final-capstone/**": "deny"
    }
  }
}
