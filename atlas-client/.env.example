# ATLAS client environment variables
# Copy to .env and adjust for your environment

# URL of the EnrollPro frontend (used for the "Back to EnrollPro" link and
# companion SSO). Fail-closed: leave unset or blank to disable companion
# navigation entirely (no raw-IP fallback is used).
VITE_ENROLLPRO_URL=http://localhost:5173

# Base URL of EnrollPro API backend (used by Vite proxy /enrollpro-api)
VITE_ENROLLPRO_API_BASE=http://localhost:5000

# Base URL of ATLAS API backend (used by Vite proxy /api)
# Leave unset to use the default localhost:5001
# VITE_ATLAS_API=http://localhost:5001

# Optional explicit EnrollPro reverse-SSO start URL. When unset it derives from
# VITE_ENROLLPRO_URL as ${VITE_ENROLLPRO_URL}/api/auth/companion-sso/atlas/reverse/start.
# VITE_ENROLLPRO_SSO_START_URL=https://dev-jegs.buru-degree.ts.net/api/auth/companion-sso/atlas/reverse/start

# --- Tailscale example (uncomment and adjust) ---
# VITE_ENROLLPRO_URL=https://dev-jegs.buru-degree.ts.net
# VITE_ENROLLPRO_API_BASE=https://dev-jegs.buru-degree.ts.net
# VITE_ATLAS_API=https://njgrm.buru-degree.ts.net
