# Atlas Server
DATABASE_URL=postgresql://atlas_user:incorrect404@localhost:5432/atlas_db?schema=public
JWT_SECRET="change-this-to-a-random-32-char-minimum-secret-key"
# Static machine-to-machine token for trusted external systems calling ATLAS APIs.
# Clients must send: Authorization: Bearer <ATLAS_SYSTEM_TOKEN> or X-Integration-Key: <ATLAS_SYSTEM_TOKEN>
ATLAS_SYSTEM_TOKEN=
PORT=5001
ENROLLPRO_API=http://localhost:5000/api
# Default school ID used when provisioning ATLAS accounts via EnrollPro credential delegation
ATLAS_DEFAULT_SCHOOL_ID=1
CLIENT_URL=https://njgrm.buru-degree.ts.net
# EnrollPro frontend origin allowed by CORS (separate from CLIENT_URL)
ENROLLPRO_CLIENT_URL=http://localhost:5173
# Additional comma-separated origins for CORS (e.g. local dev / Tailnet hostnames)
# CORS_EXTRA_ORIGINS=http://localhost:5173,https://dev-jegs.buru-degree.ts.net

# Faculty adapter: "stub" (default) or "enrollpro"
FACULTY_ADAPTER=stub
# Required when FACULTY_ADAPTER=enrollpro — a valid EnrollPro JWT with SYSTEM_ADMIN role
ENROLLPRO_SERVICE_TOKEN=

# Section source mode: enrollpro | stub | auto
#   enrollpro — always fetch live sections from EnrollPro (recommended for integration testing)
#   stub      — always use deterministic test sections (10 sections, 334 enrolled)
#   auto      — try EnrollPro first, fallback to stub with warning
# WARNING: stub mode produces fewer sections than real EnrollPro and counts will not match.
# Recommended for local dev with EnrollPro running: enrollpro
SECTION_SOURCE_MODE=enrollpro

# When true and SECTION_SOURCE_MODE=auto, fail fast instead of silently falling back to stub.
# SECTION_STRICT_UPSTREAM=false

# Companion SSO (Flow A outbound + Flow B inbound)
# EnrollPro base URL used for the server-to-server Flow A code exchange (may include a trailing /api).
ENROLLPRO_BASE_URL=https://dev-jegs.buru-degree.ts.net/api
# ATLAS -> EnrollPro outbound client secret (Flow A).
ENROLLPRO_SSO_CLIENT_SECRET=
# Registered EnrollPro reverse callback: the exact redirect_uri bound by Flow B authorize.
ENROLLPRO_SSO_CALLBACK_URL=https://dev-jegs.buru-degree.ts.net/api/auth/companion-sso/atlas/reverse/callback
# EnrollPro -> ATLAS inbound reverse secret (Flow B exchange).
ATLAS_SSO_REVERSE_CLIENT_SECRET=
# Legacy aliases still accepted: ATLAS_SSO_CLIENT_SECRET, ENROLLPRO_REVERSE_CLIENT_SECRET
# Routes: Flow A callback GET /api/v1/auth/enrollpro/callback; Flow B authorize POST /api/v1/auth/sso/authorize; Flow B exchange POST /api/v1/auth/sso/exchange; SPA /auth/enrollpro/authorize and /auth/sso/callback
