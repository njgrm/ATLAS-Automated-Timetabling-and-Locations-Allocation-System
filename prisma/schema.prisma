// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../atlas-server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                         Int                         @id @default(autoincrement())
  name                       String
  shortName                  String                      @db.VarChar(50)
  campusImageUrl             String?                     @map("campus_image_url")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  subjects                   Subject[]
  buildings                  Building[]
  facultyMirrors             FacultyMirror[]
  authAccounts               AtlasAuthAccount[]
  classTemplates             ClassTemplate[]
  classProgramSlots          ClassProgramSlot[]
  specializationAliases      SpecializationAlias[]
  sectionMirrors             SectionMirror[]
  enrollProSchoolYearMirrors EnrollProSchoolYearMirror[]
  publishedScheduleRevisions PublishedScheduleRevision[]
  teachingLoadSuggestionProposals TeachingLoadSuggestionProposal[]
  teachingLoadCycles         TeachingLoadCycle[]

  @@map("schools")
}

model EnrollProSchoolYearMirror {
  id                       Int       @id @default(autoincrement())
  schoolId                Int       @map("school_id")
  enrollProSchoolYearId    Int       @map("enrollpro_school_year_id")
  yearLabel                String    @map("year_label") @db.VarChar(32)
  isActive                 Boolean   @default(false) @map("is_active")
  lastVerifiedAt           DateTime? @map("last_verified_at")
  lastSyncedAt             DateTime? @map("last_synced_at")
  sourceEndpoint           String    @default("/api/integration/v1/school-year") @map("source_endpoint") @db.VarChar(200)
  facultyCount             Int       @default(0) @map("faculty_count")
  sectionCount             Int       @default(0) @map("section_count")
  syncStatus               String    @default("pending") @map("sync_status") @db.VarChar(32)
  lastFailureSummary       String?   @map("last_failure_summary") @db.VarChar(500)
  lastSyncMetadata         Json?     @map("last_sync_metadata")
  /// RR-09A: non-destructive archive lifecycle. An archived year keeps every
  /// row as read-only history and never wins the active-year election.
  isArchived               Boolean   @default(false) @map("is_archived")
  archivedAt               DateTime? @map("archived_at")
  archivedBy               Int?      @map("archived_by")
  archiveReason            String?   @map("archive_reason") @db.VarChar(500)
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, enrollProSchoolYearId], map: "uq_enrollpro_school_year_mirror")
  @@index([schoolId, isActive], map: "idx_enrollpro_school_year_mirror_active")
  @@map("enrollpro_school_year_mirrors")
}

model SectionMirror {
  id                 Int     @id @default(autoincrement())
  externalId         Int     @map("external_id")
  schoolId           Int     @map("school_id")
  schoolYearId       Int     @map("school_year_id")
  name               String
  gradeLevelId       Int     @map("grade_level_id")
  gradeLevelName     String  @map("grade_level_name")
  displayOrder       Int     @map("display_order")
  maxCapacity        Int     @map("max_capacity")
  enrolledCount      Int     @map("enrolled_count")
  programType        String? @map("program_type")
  programCode        String? @map("program_code")
  programName        String? @map("program_name")
  isSpecialProgram   Boolean @default(false) @map("is_special_program")
  tleProgramId       Int?    @map("tle_program_id")
  tleSpecialization  String? @map("tle_specialization")
  tleProgramCategory String? @map("tle_program_category")

  // ATLAS-specific metadata/overrides
  isActiveForScheduling Boolean @default(true) @map("is_active_for_scheduling")
  preferredRoomId       Int?    @map("preferred_room_id")
  // Phase 1a-2 / Phase 2 Home-Room prereq
  homeRoomId            Int?    @map("home_room_id")
  buildingZoneId        String? @map("building_zone_id") @db.VarChar(32)

  lastSyncedAt DateTime  @default(now()) @map("last_synced_at")
  isStale      Boolean   @default(false) @map("is_stale")
  staleReason  String?   @map("stale_reason")
  staleAt      DateTime? @map("stale_at")

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, schoolYearId, externalId])
  @@index([schoolId, schoolYearId])
  @@map("section_mirrors")
}

model SpecializationAlias {
  id        Int      @id @default(autoincrement())
  schoolId  Int      @map("school_id")
  canonical String // e.g. "Mathematics"
  alias     String // e.g. "Algebra"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, canonical, alias])
  @@index([schoolId])
  @@map("specialization_aliases")
}

model Building {
  id                 Int      @id @default(autoincrement())
  schoolId           Int      @map("school_id")
  name               String
  shortCode          String?  @map("short_code") @db.VarChar(20)
  x                  Float    @default(0)
  y                  Float    @default(0)
  width              Float    @default(200)
  height             Float    @default(120)
  rotation           Float    @default(0)
  color              String   @default("#2563eb")
  floorCount         Int      @default(1) @map("floor_count")
  isTeachingBuilding Boolean  @default(true) @map("is_teaching_building")
  gradeScope         Int[]    @default([]) @map("grade_scope")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rooms              Room[]

  @@map("buildings")
}

enum RoomType {
  CLASSROOM
  LABORATORY
  COMPUTER_LAB
  TLE_WORKSHOP
  LIBRARY
  GYMNASIUM
  FACULTY_ROOM
  OFFICE
  OTHER

  @@map("room_type")
}

model Room {
  id                       Int                     @id @default(autoincrement())
  buildingId               Int                     @map("building_id")
  name                     String
  floor                    Int                     @default(1)
  floorNumber              Int?                    @map("floor_number")
  buildingZoneId           String?                 @map("building_zone_id") @db.VarChar(32)
  type                     RoomType                @default(CLASSROOM)
  capacity                 Int?
  isTeachingSpace          Boolean                 @default(true) @map("is_teaching_space")
  isSharedFacility         Boolean                 @default(false) @map("is_shared_facility")
  floorPosition            Int                     @default(0) @map("floor_position")
  features                 String[]                @default([])
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  building                 Building                @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  requestedRoomPreferences FacultyRoomPreference[] @relation("RequestedRoomPreferences")

  @@map("rooms")
}

enum SubjectQualificationPriority {
  DEPARTMENT_FIRST
  SPECIALIZATION_PRIMARY

  @@map("subject_qualification_priority")
}

model Subject {
  id                      Int                          @id @default(autoincrement())
  schoolId                Int                          @map("school_id")
  code                    String                       @db.VarChar(32)
  outputLabel             String?                      @map("output_label") @db.VarChar(64)
  name                    String
  ownerDepartment         String?                      @map("owner_department") @db.VarChar(32)
  qualificationPriority   SubjectQualificationPriority @default(DEPARTMENT_FIRST) @map("qualification_priority")
  rotationFamily          String?                      @map("rotation_family") @db.VarChar(64)
  minMinutesPerWeek       Int                          @map("min_minutes_per_week")
  preferredRoomType       RoomType                     @default(CLASSROOM) @map("preferred_room_type")
  modularGroupId          String?                      @map("modular_group_id") @db.VarChar(64)
  modularOrder            Int?                         @map("modular_order")
  termGroupId             String?                      @map("term_group_id") @db.VarChar(64)
  termCount               Int                          @default(3) @map("term_count")
  gradeLevels             Int[]                        @map("grade_levels")
  isActive                Boolean                      @default(true) @map("is_active")
  isSeedable              Boolean                      @default(false) @map("is_seedable")
  isSystemManaged         Boolean                      @default(false) @map("is_system_managed")
  interSectionEnabled     Boolean                      @default(false) @map("inter_section_enabled")
  interSectionGradeLevels Int[]                        @default([]) @map("inter_section_grade_levels")
  programScopes           ProgramType[]                @default([REGULAR]) @map("program_scopes")
  allowedSpecializations  String[]                     @default([]) @map("allowed_specializations")
  requiredFeatures        String[]                     @default([]) @map("required_features")
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  school                  School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  facultySubjects         FacultySubject[]
  templateBindings        ClassTemplateSubject[]

  @@unique([schoolId, code], map: "uq_subjects_school_code")
  @@index([schoolId])
  @@map("subjects")
}

enum AncillaryLoadSource {
  HR
  LOCAL
  NONE

  @@map("ancillary_load_source")
}

model FacultyMirror {
  id                        Int                     @id @default(autoincrement())
  externalId                Int                     @map("external_id")
  employeeId                String?                 @unique(map: "uq_faculty_employee_id") @map("employee_id") @db.VarChar(7)
  schoolId                  Int                     @map("school_id")
  firstName                 String                  @map("first_name")
  lastName                  String                  @map("last_name")
  department                String?
  specialization            String?
  employmentStatus          String                  @default("PERMANENT") @map("employment_status")
  contactInfo               String?                 @map("contact_info")
  avatarUrl                 String?                 @map("avatar_url")
  localNotes                String?                 @map("local_notes")
  isActiveForScheduling     Boolean                 @default(true) @map("is_active_for_scheduling")
  isClassAdviser            Boolean                 @default(false) @map("is_class_adviser")
  advisoryEquivalentHours   Int                     @default(0) @map("advisory_equivalent_hours")
  ancillaryMinutesPerWeek   Int?                    @map("ancillary_minutes_per_week")
  ancillaryLoadSource       AncillaryLoadSource     @default(NONE) @map("ancillary_load_source")
  canTeachOutsideDepartment Boolean                 @default(false) @map("can_teach_outside_department")
  isPlaceholder             Boolean                 @default(false) @map("is_placeholder")
  maxHoursPerWeek           Int                     @default(30) @map("max_hours_per_week")
  lastSyncedAt              DateTime                @default(now()) @map("last_synced_at")
  // Stale tracking (Wave 3.5)
  isStale                   Boolean                 @default(false) @map("is_stale")
  staleReason               String?                 @map("stale_reason")
  staleAt                   DateTime?               @map("stale_at")
  // Adviser mapping (Wave 3.5)
  advisedSectionId          Int?                    @map("advised_section_id")
  advisedSectionName        String?                 @map("advised_section_name")
  // Official teacher profile fields (teacher-program DOCX export)
  plantillaPosition         String?                 @map("plantilla_position")
  designationTitle          String?                 @map("designation_title")
  undergraduateDegree       String?                 @map("undergraduate_degree")
  postgraduateDegree        String?                 @map("postgraduate_degree")
  majorSpecialization       String?                 @map("major_specialization")
  minorSpecialization       String?                 @map("minor_specialization")
  ancillaryRoles            String[]                @default([]) @map("ancillary_roles")
  version                   Int                     @default(1)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  school                    School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  facultySubjects           FacultySubject[]
  preferences               FacultyPreference[]
  roomPreferences           FacultyRoomPreference[]
  roomRequestAppeals        RoomRequestAppeal[]
  authAccounts              AtlasAuthAccount[]

  @@unique([schoolId, externalId], map: "uq_faculty_school_external")
  @@index([schoolId])
  @@index([schoolId, isStale])
  @@map("faculty_mirrors")
}

model AtlasAuthAccount {
  id                 Int            @id @default(autoincrement())
  schoolId           Int            @map("school_id")
  facultyId          Int?           @map("faculty_id")
  email              String         @unique @db.VarChar(254)
  employeeId         String?        @unique(map: "uq_auth_employee_id") @map("employee_id") @db.VarChar(7)
  accountName        String?        @unique(map: "uq_auth_account_name") @map("account_name")
  role               String         @db.VarChar(32)
  passwordHash       String         @map("password_hash")
  isActive           Boolean        @default(true) @map("is_active")
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  failedLoginCount   Int            @default(0) @map("failed_login_count")
  lockedUntil        DateTime?      @map("locked_until")
  lastLoginAt        DateTime?      @map("last_login_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  school             School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  faculty            FacultyMirror? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@index([schoolId, role])
  @@index([facultyId])
  @@map("atlas_auth_accounts")
}

model FacultySubject {
  id          Int           @id @default(autoincrement())
  facultyId   Int           @map("faculty_id")
  subjectId   Int           @map("subject_id")
  schoolId    Int           @map("school_id")
  /// NULL rows predate annual Teaching Load scoping and are retained as legacy evidence.
  schoolYearId Int?         @map("school_year_id")
  gradeLevels Int[]         @map("grade_levels")
  sectionIds  Int[]         @default([]) @map("section_ids")
  assignedBy  Int           @map("assigned_by")
  assignedAt  DateTime      @default(now()) @map("assigned_at")
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  faculty     FacultyMirror @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  sectionOwnerships SubjectSectionOwnership[]

  @@unique([facultyId, subjectId, schoolYearId], map: "uq_faculty_subject_year")
  @@index([schoolId, schoolYearId])
  @@index([facultyId])
  @@index([subjectId])
  @@map("faculty_subjects")
}

// ─── Phase 4: Normalized section-ownership index ─────────────────────────────
// One row per (schoolId, subjectId, sectionId). The unique index on these three
// columns is the DB-level hard guardrail preventing duplicate ownership.
// Kept in sync with FacultySubject.sectionIds by setAssignments() (Prompt B).
// Cascade-deleted when the parent FacultySubject row is removed.
model SubjectSectionOwnership {
  id                  Int      @id @default(autoincrement())
  schoolId            Int      @map("school_id")
  /// NULL rows predate annual Teaching Load scoping and are retained as legacy evidence.
  schoolYearId        Int?     @map("school_year_id")
  facultySubjectId    Int      @map("faculty_subject_id")
  facultyId           Int      @map("faculty_id")
  subjectId           Int      @map("subject_id")
  /// External section ID — matches SectionMirror.externalId (not its PK)
  sectionId           Int      @map("section_id")
  specializationCode  String?  @map("specialization_code") @db.VarChar(64)
  specializationLabel String?  @map("specialization_label") @db.VarChar(128)
  /// Copied from parent FacultySubject.assignedAt for repair-priority queries
  assignedAt          DateTime @default(now()) @map("assigned_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  facultySubject FacultySubject @relation(fields: [facultySubjectId], references: [id], onDelete: Cascade)

  /// DB-level uniqueness: one owner per school year + subject + section.
  @@unique([schoolId, schoolYearId, subjectId, sectionId], map: "uq_subject_section_owner_year")
  @@index([facultySubjectId])
  @@index([schoolId, schoolYearId, subjectId])
  @@index([facultyId])
  @@map("subject_section_ownerships")
}

enum TeachingLoadCycleState {
  EMPTY
  POPULATED

  @@map("teaching_load_cycle_state")
}

/// Annual Teaching Load boundary. A cycle exists even when the active year has no assignments.
model TeachingLoadCycle {
  id           Int                    @id @default(autoincrement())
  schoolId     Int                    @map("school_id")
  schoolYearId Int                    @map("school_year_id")
  state        TeachingLoadCycleState @default(EMPTY)
  version      Int                    @default(1)
  initializedAt DateTime              @default(now()) @map("initialized_at")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, schoolYearId], map: "uq_teaching_load_cycle")
  @@index([schoolId, schoolYearId, state])
  @@map("teaching_load_cycles")
}

enum TeachingLoadSuggestionStatus {
  PENDING
  APPLIED
  CANCELLED
  SUPERSEDED
  EXPIRED

  @@map("teaching_load_suggestion_status")
}

model TeachingLoadSuggestionProposal {
  id                       Int                          @id @default(autoincrement())
  schoolId                 Int                          @map("school_id")
  schoolYearId             Int                          @map("school_year_id")
  coverageMode             String                       @map("coverage_mode") @db.VarChar(48)
  status                   TeachingLoadSuggestionStatus @default(PENDING)
  previewPayload           Json                         @map("preview_payload")
  refreshedPreviewPayload  Json?                        @map("refreshed_preview_payload")
  applyPayload             Json?                        @map("apply_payload")
  sectionSource            String?                      @map("section_source") @db.VarChar(48)
  sectionFallbackReason    String?                      @map("section_fallback_reason") @db.VarChar(500)
  suggestedAssignmentCount Int                          @default(0) @map("suggested_assignment_count")
  unresolvedCount          Int                          @default(0) @map("unresolved_count")
  warningCount             Int                          @default(0) @map("warning_count")
  createdBy                Int?                         @map("created_by")
  appliedBy                Int?                         @map("applied_by")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  appliedAt                DateTime?                    @map("applied_at")
  cancelledAt              DateTime?                    @map("cancelled_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, schoolYearId, status], map: "idx_teaching_load_suggestion_scope_status")
  @@index([createdBy], map: "idx_teaching_load_suggestion_created_by")
  @@map("teaching_load_suggestion_proposals")
}

// ─── Phase 2: Faculty Preferences ───

enum PreferenceStatus {
  DRAFT
  SUBMITTED

  @@map("preference_status")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY

  @@map("day_of_week")
}

enum TimeSlotPreference {
  PREFERRED
  AVAILABLE
  UNAVAILABLE

  @@map("time_slot_preference")
}

model FacultyPreference {
  id                     Int              @id @default(autoincrement())
  schoolId               Int              @map("school_id")
  schoolYearId           Int              @map("school_year_id")
  facultyId              Int              @map("faculty_id")
  status                 PreferenceStatus @default(DRAFT)
  notes                  String?
  submittedAt            DateTime?        @map("submitted_at")
  version                Int              @default(1)
  // Well-being preference toggles
  pregnancySupport       Boolean          @default(false) @map("pregnancy_support")
  physicalAilmentSupport Boolean          @default(false) @map("physical_ailment_support")
  minimizeTravelTime     Boolean          @default(false) @map("minimize_travel_time")
  avoidUpperFloors       Boolean          @default(false) @map("avoid_upper_floors")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  faculty   FacultyMirror        @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  timeSlots PreferenceTimeSlot[]
  review    PreferenceReview?

  @@unique([schoolId, schoolYearId, facultyId], map: "uq_preference_school_year_faculty")
  @@index([schoolId, schoolYearId])
  @@index([facultyId])
  @@map("faculty_preferences")
}

model PreferenceTimeSlot {
  id           Int                @id @default(autoincrement())
  preferenceId Int                @map("preference_id")
  day          DayOfWeek
  startTime    String             @map("start_time")
  endTime      String             @map("end_time")
  preference   TimeSlotPreference @default(AVAILABLE)
  createdAt    DateTime           @default(now())

  facultyPreference FacultyPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@index([preferenceId])
  @@map("preference_time_slots")
}

// ─── Phase 2: Officer Review Metadata ───

enum ReviewStatus {
  PENDING
  REVIEWED
  NEEDS_FOLLOW_UP

  @@map("review_status")
}

model PreferenceReview {
  id            Int          @id @default(autoincrement())
  preferenceId  Int          @map("preference_id")
  reviewerId    Int          @map("reviewer_id")
  reviewStatus  ReviewStatus @default(PENDING) @map("review_status")
  reviewerNotes String?      @map("reviewer_notes")
  reviewedAt    DateTime?    @map("reviewed_at")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  preference FacultyPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@unique([preferenceId], map: "uq_preference_review")
  @@index([reviewerId])
  @@index([reviewStatus])
  @@map("preference_reviews")
}

enum RoomPreferenceStatus {
  DRAFT
  SUBMITTED

  @@map("room_preference_status")
}

enum RoomPreferenceDecisionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("room_preference_decision_status")
}

model FacultyRoomPreference {
  id              Int                          @id @default(autoincrement())
  schoolId        Int                          @map("school_id")
  schoolYearId    Int                          @map("school_year_id")
  runId           Int                          @map("run_id")
  entryId         String                       @map("entry_id") @db.VarChar(64)
  facultyId       Int                          @map("faculty_id")
  subjectId       Int                          @map("subject_id")
  sectionId       Int                          @map("section_id")
  currentRoomId   Int                          @map("current_room_id")
  requestedRoomId Int                          @map("requested_room_id")
  day             DayOfWeek
  startTime       String                       @map("start_time")
  endTime         String                       @map("end_time")
  termIndex       Int                          @default(1) @map("term_index")
  rationale       String?
  status          RoomPreferenceStatus         @default(DRAFT)
  submittedAt     DateTime?                    @map("submitted_at")
  version         Int                          @default(1)
  reviewerId      Int?                         @map("reviewer_id")
  decisionStatus  RoomPreferenceDecisionStatus @default(PENDING) @map("decision_status")
  reviewerNotes   String?                      @map("reviewer_notes")
  reviewedAt      DateTime?                    @map("reviewed_at")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")

  faculty       FacultyMirror       @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  requestedRoom Room                @relation("RequestedRoomPreferences", fields: [requestedRoomId], references: [id], onDelete: Cascade)
  run           GenerationRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  appeals       RoomRequestAppeal[]

  @@unique([runId, entryId], map: "uq_room_preference_run_entry")
  @@index([schoolId, schoolYearId, status])
  @@index([schoolId, schoolYearId, decisionStatus])
  @@index([runId, facultyId])
  @@index([requestedRoomId, day, startTime])
  @@map("faculty_room_preferences")
}

enum RoomRequestAppealStatus {
  OPEN
  UNDER_REVIEW
  UPHELD
  DENIED

  @@map("room_request_appeal_status")
}

enum RoomRequestAppealHistoryAction {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  DECISION_RECORDED

  @@map("room_request_appeal_history_action")
}

model RoomRequestAppeal {
  id           Int                     @id @default(autoincrement())
  schoolId     Int                     @map("school_id")
  schoolYearId Int                     @map("school_year_id")
  runId        Int                     @map("run_id")
  requestId    Int                     @map("request_id")
  requesterId  Int                     @map("requester_id")
  reason       String
  status       RoomRequestAppealStatus @default(OPEN)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  request   FacultyRoomPreference      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requester FacultyMirror              @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  history   RoomRequestAppealHistory[]

  @@index([schoolId, schoolYearId, runId])
  @@index([requestId])
  @@index([requesterId])
  @@map("room_request_appeals")
}

model RoomRequestAppealHistory {
  id         Int                            @id @default(autoincrement())
  appealId   Int                            @map("appeal_id")
  actorId    Int                            @map("actor_id")
  action     RoomRequestAppealHistoryAction
  fromStatus RoomRequestAppealStatus?       @map("from_status")
  toStatus   RoomRequestAppealStatus?       @map("to_status")
  note       String?
  createdAt  DateTime                       @default(now()) @map("created_at")

  appeal RoomRequestAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([appealId, createdAt])
  @@map("room_request_appeal_history")
}

// ─── Phase 3: Timetable Generation ───

// ─── Scheduling Policy ───

model SchedulingPolicy {
  id                                       Int      @id @default(autoincrement())
  schoolId                                 Int      @map("school_id")
  schoolYearId                             Int      @map("school_year_id")
  teacherMoveEnabled                       Boolean  @default(true) @map("teacher_move_enabled")
  periodLengthMinutes                      Int      @default(45) @map("period_length_minutes")
  periodsPerDay                            Int      @default(10) @map("periods_per_day")
  maxConsecutiveTeachingMinutesBeforeBreak Int      @default(120) @map("max_consecutive_teaching_minutes_before_break")
  minBreakMinutesAfterConsecutiveBlock     Int      @default(15) @map("min_break_minutes_after_consecutive_block")
  maxTeachingMinutesPerDay                 Int      @default(400) @map("max_teaching_minutes_per_day")
  earliestStartTime                        String   @default("07:00") @map("earliest_start_time")
  latestEndTime                            String   @default("18:30") @map("latest_end_time")
  enforceConsecutiveBreakAsHard            Boolean  @default(false) @map("enforce_consecutive_break_as_hard")
  enableTravelWellbeingChecks              Boolean  @default(true) @map("enable_travel_wellbeing_checks")
  maxWalkingDistanceMetersPerTransition    Int      @default(120) @map("max_walking_distance_meters_per_transition")
  maxBuildingTransitionsPerDay             Int      @default(4) @map("max_building_transitions_per_day")
  maxBackToBackTransitionsWithoutBuffer    Int      @default(2) @map("max_back_to_back_transitions_without_buffer")
  maxIdleGapMinutesPerDay                  Int      @default(60) @map("max_idle_gap_minutes_per_day")
  avoidEarlyFirstPeriod                    Boolean  @default(false) @map("avoid_early_first_period")
  avoidLateLastPeriod                      Boolean  @default(false) @map("avoid_late_last_period")
  enableVacantAwareConstraints             Boolean  @default(false) @map("enable_vacant_aware_constraints")
  targetFacultyDailyVacantMinutes          Int      @default(60) @map("target_faculty_daily_vacant_minutes")
  targetSectionDailyVacantPeriods          Int      @default(1) @map("target_section_daily_vacant_periods")
  maxCompressedTeachingMinutesPerDay       Int      @default(300) @map("max_compressed_teaching_minutes_per_day")
  lunchStartTime                           String   @default("11:55") @map("lunch_start_time")
  lunchEndTime                             String   @default("12:55") @map("lunch_end_time")
  enforceLunchWindow                       Boolean  @default(true) @map("enforce_lunch_window")
  showSpecialEventsInGrid                  Boolean  @default(true) @map("show_special_events_in_grid")
  enableFlagCeremony                       Boolean  @default(true) @map("enable_flag_ceremony")
  flagCeremonyStartTime                    String   @default("07:00") @map("flag_ceremony_start_time")
  flagCeremonyEndTime                      String   @default("07:30") @map("flag_ceremony_end_time")
  enableRecess                             Boolean  @default(true) @map("enable_recess")
  recessStartTime                          String   @default("09:45") @map("recess_start_time")
  recessEndTime                            String   @default("10:00") @map("recess_end_time")
  enableLunchWindow                        Boolean  @default(true) @map("enable_lunch_window")
  enableTleTwoPassPriority                 Boolean  @default(true) @map("enable_tle_two_pass_priority")
  allowFlexibleSubjectAssignment           Boolean  @default(false) @map("allow_flexible_subject_assignment")
  allowConsecutiveLabSessions              Boolean  @default(false) @map("allow_consecutive_lab_sessions")
  constraintConfig                         Json?    @map("constraint_config")
  createdAt                                DateTime @default(now())
  updatedAt                                DateTime @updatedAt

  @@unique([schoolId, schoolYearId])
  @@map("scheduling_policies")
}

// ─── Policy Special Events (shift-specific breaks) ───
// Uniqueness is enforced by 4 partial unique indexes in migration 0036.
// Prisma cannot represent partial indexes, so @@unique is intentionally omitted.
// Service-level upsert uses findFirst to prevent duplicates within each scope.

model PolicySpecialEvent {
  id             Int      @id @default(autoincrement())
  schoolId       Int      @map("school_id")
  schoolYearId   Int      @map("school_year_id")
  eventType      String   @map("event_type") @db.VarChar(48)
  label          String   @map("label") @db.VarChar(120)
  gradeGroup     String?  @map("grade_group") @db.VarChar(24)
  programType    String?  @map("program_type") @db.VarChar(24)
  startTime      String   @map("start_time") @db.VarChar(5)
  endTime        String   @map("end_time") @db.VarChar(5)
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([schoolId, schoolYearId], map: "idx_policy_special_events_scope")
  @@map("policy_special_events")
}

// ─── Generation Run ───

enum GenerationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED

  @@map("generation_run_status")
}

model GenerationRun {
  id              Int                 @id @default(autoincrement())
  schoolId        Int                 @map("school_id")
  schoolYearId    Int                 @map("school_year_id")
  status          GenerationRunStatus @default(QUEUED)
  runType         String              @default("FULL") @map("run_type") @db.VarChar(20)
  triggeredBy     Int                 @map("triggered_by")
  startedAt       DateTime?           @map("started_at")
  finishedAt      DateTime?           @map("finished_at")
  durationMs      Int?                @map("duration_ms")
  summary         Json?
  violations      Json?
  draftEntries    Json?               @map("draft_entries")
  unassignedItems Json?               @map("unassigned_items")
  error           String?
  version         Int                 @default(1)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  manualEdits                ManualScheduleEdit[]
  roomPreferences            FacultyRoomPreference[]
  publishedScheduleRevisions PublishedScheduleRevision[] @relation("PublishedRevisionSourceRun")

  @@index([schoolId, schoolYearId, createdAt])
  @@index([status])
  @@map("generation_runs")
}

// ─── Manual Schedule Edit ───

enum ManualEditType {
  PLACE_UNASSIGNED
  MOVE_ENTRY
  CHANGE_ROOM
  CHANGE_FACULTY
  CHANGE_TIMESLOT
  SWAP_ENTRIES
  REVERT

  @@map("manual_edit_type")
}

model ManualScheduleEdit {
  id                Int            @id @default(autoincrement())
  runId             Int            @map("run_id")
  schoolId          Int            @map("school_id")
  schoolYearId      Int            @map("school_year_id")
  actorId           Int            @map("actor_id")
  editType          ManualEditType @map("edit_type")
  beforePayload     Json           @map("before_payload")
  afterPayload      Json           @map("after_payload")
  validationSummary Json?          @map("validation_summary")
  createdAt         DateTime       @default(now())

  run GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([schoolId, schoolYearId])
  @@map("manual_schedule_edits")
}

// ─── Published Schedule Revision ───

enum PublishedRevisionStatus {
  DRAFT
  SCHEDULED
  SUPERSEDED

  @@map("published_revision_status")
}

model PublishedScheduleRevision {
  id               Int                     @id @default(autoincrement())
  schoolId         Int                     @map("school_id")
  schoolYearId     Int                     @map("school_year_id")
  sourceRunId      Int                     @map("source_run_id")
  sourceRevisionId Int?                    @map("source_revision_id")
  status           PublishedRevisionStatus @default(SCHEDULED)
  effectiveDate    DateTime                @map("effective_date")
  actorId          Int?                    @map("actor_id")
  reason           String                  @db.VarChar(500)
  changeSet        Json                    @map("change_set")
  changeSummary    Json?                   @map("change_summary")
  previousValues   Json                    @map("previous_values")
  newValues        Json                    @map("new_values")
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  school               School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sourceRun            GenerationRun               @relation("PublishedRevisionSourceRun", fields: [sourceRunId], references: [id], onDelete: Restrict)
  sourceRevision       PublishedScheduleRevision?  @relation("PublishedRevisionChain", fields: [sourceRevisionId], references: [id], onDelete: SetNull)
  supersedingRevisions PublishedScheduleRevision[] @relation("PublishedRevisionChain")

  @@index([schoolId, schoolYearId, effectiveDate])
  @@index([sourceRunId, effectiveDate])
  @@index([sourceRevisionId])
  @@index([status])
  @@map("published_schedule_revisions")
}

// ─── Audit Log ───

model AuditLog {
  id           Int      @id @default(autoincrement())
  schoolId     Int      @map("school_id")
  schoolYearId Int?     @map("school_year_id")
  action       String   @db.VarChar(50)
  actorId      Int      @map("actor_id")
  targetIds    Int[]    @map("target_ids")
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([schoolId, action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Follow-Up Flag ───

model FollowUpFlag {
  id        Int      @id @default(autoincrement())
  runId     Int      @map("run_id")
  entryId   String   @map("entry_id") @db.VarChar(64)
  note      String?
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now())

  @@unique([runId, entryId])
  @@index([runId])
  @@map("follow_up_flags")
}

// ─── Pre-Generation Locked Sessions ───

enum PreGenerationDraftStatus {
  DRAFT
  LOCKED_FOR_RUN
  ARCHIVED

  @@map("pre_generation_draft_status")
}

enum PreGenerationDraftEntryKind {
  SECTION
  COHORT

  @@map("pre_generation_draft_entry_kind")
}

model LockedSession {
  id           Int                         @id @default(autoincrement())
  schoolId     Int                         @map("school_id")
  schoolYearId Int                         @map("school_year_id")
  entryKind    PreGenerationDraftEntryKind @default(SECTION) @map("entry_kind")
  sectionId    Int                         @map("section_id")
  subjectId    Int                         @map("subject_id")
  facultyId    Int?                        @map("faculty_id")
  roomId       Int?                        @map("room_id")
  cohortCode   String?                     @map("cohort_code") @db.VarChar(50)
  status       PreGenerationDraftStatus    @default(DRAFT)
  lockedRunId  Int?                        @map("locked_run_id")
  notes        String?
  version      Int                         @default(1)
  day          DayOfWeek
  startTime    String                      @map("start_time")
  endTime      String                      @map("end_time")
  termIndex    Int                         @default(1) @map("term_index")
  createdBy    Int                         @map("created_by")
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  actions      LockedSessionAction[]

  @@unique([schoolId, schoolYearId, entryKind, sectionId, subjectId, cohortCode, day, startTime], map: "uq_locked_session")
  @@index([schoolId, schoolYearId])
  @@index([schoolId, schoolYearId, status])
  @@index([lockedRunId])
  @@map("locked_sessions")
}

model LockedSessionAction {
  id            Int      @id @default(autoincrement())
  lockId        Int?     @map("lock_id")
  schoolId      Int      @map("school_id")
  schoolYearId  Int      @map("school_year_id")
  actorId       Int      @map("actor_id")
  actionType    String   @map("action_type") @db.VarChar(50)
  beforePayload Json?    @map("before_payload")
  afterPayload  Json?    @map("after_payload")
  createdAt     DateTime @default(now())

  lock LockedSession? @relation(fields: [lockId], references: [id], onDelete: SetNull)

  @@index([lockId, createdAt])
  @@index([schoolId, schoolYearId, createdAt])
  @@map("locked_session_actions")
}

// ─── Grade Shift Windows ───

model GradeShiftWindow {
  id           Int          @id @default(autoincrement())
  schoolId     Int          @map("school_id")
  schoolYearId Int          @map("school_year_id")
  gradeLevel   Int          @map("grade_level")
  programType  ProgramType? @map("program_type")
  startTime    String       @map("start_time")
  endTime      String       @map("end_time")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([schoolId, schoolYearId, gradeLevel, programType], map: "uq_grade_shift_window")
  @@index([schoolId, schoolYearId])
  @@map("grade_shift_windows")
}

// ─── Wave 3.5: Durable Cache (Source-of-Truth Hardening) ───

model FacultySnapshot {
  id            Int      @id @default(autoincrement())
  schoolId      Int      @map("school_id")
  schoolYearId  Int      @map("school_year_id")
  fetchedAt     DateTime @default(now()) @map("fetched_at")
  source        String   @default("enrollpro")
  checksum      String?
  schemaVersion Int      @default(1) @map("schema_version")
  payload       Json
  createdAt     DateTime @default(now())

  @@unique([schoolId, schoolYearId], map: "uq_faculty_snapshot_school_year")
  @@index([schoolId, fetchedAt])
  @@map("faculty_snapshots")
}

model SectionSnapshot {
  id            Int      @id @default(autoincrement())
  schoolId      Int      @map("school_id")
  schoolYearId  Int      @map("school_year_id")
  fetchedAt     DateTime @default(now()) @map("fetched_at")
  source        String   @default("enrollpro")
  checksum      String?
  schemaVersion Int      @default(1) @map("schema_version")
  payload       Json
  createdAt     DateTime @default(now())

  @@unique([schoolId, schoolYearId], map: "uq_section_snapshot_school_year")
  @@index([schoolId, fetchedAt])
  @@map("section_snapshots")
}

// ─── Wave 3.5: Special Program Types ───

enum ProgramType {
  REGULAR
  STE
  SPS
  SPA
  OTHER

  @@map("program_type")
}

// ─── Wave 3.5: TLE Inter-section Cohorts ───

model InstructionalCohort {
  id                 Int       @id @default(autoincrement())
  schoolId           Int       @map("school_id")
  schoolYearId       Int       @map("school_year_id")
  cohortCode         String    @map("cohort_code") @db.VarChar(50)
  specializationCode String    @map("specialization_code") @db.VarChar(20)
  specializationName String    @map("specialization_name")
  gradeLevel         Int       @map("grade_level")
  memberSectionIds   Int[]     @map("member_section_ids")
  expectedEnrollment Int       @default(0) @map("expected_enrollment")
  preferredRoomType  RoomType? @map("preferred_room_type")
  isActive           Boolean   @default(true) @map("is_active")
  sourceRef          String?   @map("source_ref")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([schoolId, schoolYearId, cohortCode], map: "uq_cohort_code")
  @@index([schoolId, schoolYearId, gradeLevel])
  @@map("instructional_cohorts")
}

// ─── Class Templates: Configurable per-school schedule profiles ───

model ClassTemplate {
  id                  Int                    @id @default(autoincrement())
  schoolId            Int                    @map("school_id")
  name                String
  label               String
  programType         ProgramType            @map("program_type")
  gradeApplicability  Int[]                  @map("grade_applicability")
  periodLengthMinutes Int                    @default(50) @map("period_length_minutes")
  periodsPerDay       Int                    @default(8) @map("periods_per_day")
  isActive            Boolean                @default(true) @map("is_active")
  isDefault           Boolean                @default(false) @map("is_default")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  school              School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectBindings     ClassTemplateSubject[]

  @@unique([schoolId, programType], map: "uq_class_template_school_program")
  @@index([schoolId])
  @@map("class_templates")
}

model ClassTemplateSubject {
  id         Int           @id @default(autoincrement())
  templateId Int           @map("template_id")
  subjectId  Int           @map("subject_id")
  createdAt  DateTime      @default(now())
  template   ClassTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  subject    Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([templateId, subjectId], map: "uq_template_subject")
  @@index([templateId])
  @@index([subjectId])
  @@map("class_template_subjects")
}

/// Canonical class-program slot template — defines subject-by-timeslot assignments
/// for grade/program-specific scheduling (e.g., Grade 9/10 afternoon frame).
model ClassProgramSlot {
  id             Int              @id @default(autoincrement())
  schoolId       Int              @map("school_id")
  schoolYearId   Int              @map("school_year_id")
  gradeLevel     Int              @map("grade_level")
  programType    ProgramType?     @map("program_type")
  dayOfWeek      String?          @map("day_of_week") @db.VarChar(16)
  startTime      String           @map("start_time") @db.VarChar(5)
  endTime        String           @map("end_time") @db.VarChar(5)
  rowKind        ClassProgramSlotKind @map("row_kind")
  subjectFamily  String?          @map("subject_family") @db.VarChar(64)
  subjectLabel   String?          @map("subject_label") @db.VarChar(128)
  sourceLabel    String           @default("TEMPLATE") @map("source_label") @db.VarChar(64)
  sourceNote     String?          @map("source_note")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, schoolYearId, gradeLevel, programType, dayOfWeek, startTime, rowKind], map: "uq_class_program_slot")
  @@index([schoolId, schoolYearId, gradeLevel, programType])
  @@map("class_program_slots")
}

enum ClassProgramSlotKind {
  CLASS
  BREAK
  SPECIAL_EVENT
  CONFLICT

  @@map("class_program_slot_kind")
}
