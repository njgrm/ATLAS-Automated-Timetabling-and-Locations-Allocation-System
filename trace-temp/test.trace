{"type":"before","callId":"pw:api@112","stepId":"pw:api@112","startTime":108115.934,"class":"Test","method":"pw:api","title":"Evaluate","params":{"expression":"() => {\n    if (typeof window.__stopFpsCounter === 'function') window.__stopFpsCounter();\n    const ticks = window.__fpsTicks || [];\n    if (ticks.length < 2) return {\n      fps: 60,\n      jitterMs: 0,\n      frameCount: ticks.length\n    };\n    const intervals = [];\n    for (let i = 1; i < ticks.length; i++) intervals.push(ticks[i] - ticks[i - 1]);\n    const totalDuration = ticks[ticks.length - 1] - ticks[0];\n    const fps = ticks.length / totalDuration * 1000;\n    const avgInterval = totalDuration / intervals.length;\n    const sqDiffs = intervals.map(val => Math.pow(val - avgInterval, 2));\n    const avgSqDiff = sqDiffs.reduce((sum, val) => sum + val, 0) / sqDiffs.length;\n    return {\n      fps,\n      jitterMs: Math.sqrt(avgSqDiff),\n      frameCount: ticks.length,\n      durationMs: totalDuration\n    };\n  }","isFunction":"true","arg":"Object"},"stack":[{"file":"D:\\ATLAS\\qa-artifacts\\playwright\\specs\\timetable-performance.spec.ts","line":54,"column":21,"function":"stopFrameCounter"}]}
{"type":"after","callId":"pw:api@112","endTime":108143.933,"annotations":[]}
{"type":"before","callId":"pw:api@113","stepId":"pw:api@113","startTime":108146.78,"class":"Test","method":"pw:api","title":"Evaluate","params":{"expression":"() => {\n    const navEntry = performance.getEntriesByType('navigation')[0];\n    const resources = performance.getEntriesByType('resource');\n    const jsResources = resources.filter(r => r.name.match(/\\.(js|ts|jsx|tsx)(\\?.*)?$/) || r.name.includes('/assets/'));\n    const totalJSTransferBytes = jsResources.reduce((sum, r) => sum + (r.transferSize || 0), 0);\n    const decodedBodySize = jsResources.reduce((sum, r) => sum + (r.decodedBodySize || 0), 0);\n    return {\n      navigation: navEntry ? {\n        duration: navEntry.duration,\n        domInteractive: navEntry.domInteractive,\n        responseEnd: navEntry.responseEnd\n      } : null,\n      jsTransferBytes: totalJSTransferBytes,\n      jsDecodedBytes: decodedBodySize,\n      jsFileCount: jsResources.length,\n      profilerLogs: window.__reactProfilerLogs || []\n    };\n  }","isFunction":"true","arg":"Object"},"stack":[{"file":"D:\\ATLAS\\qa-artifacts\\playwright\\specs\\timetable-performance.spec.ts","line":23,"column":21,"function":"getPerformanceMetrics"}]}
