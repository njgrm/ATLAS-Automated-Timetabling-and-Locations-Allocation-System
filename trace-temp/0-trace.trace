{"type":"before","callId":"call@377","startTime":108116.724,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n    if (typeof window.__stopFpsCounter === 'function') window.__stopFpsCounter();\n    const ticks = window.__fpsTicks || [];\n    if (ticks.length < 2) return {\n      fps: 60,\n      jitterMs: 0,\n      frameCount: ticks.length\n    };\n    const intervals = [];\n    for (let i = 1; i < ticks.length; i++) intervals.push(ticks[i] - ticks[i - 1]);\n    const totalDuration = ticks[ticks.length - 1] - ticks[0];\n    const fps = ticks.length / totalDuration * 1000;\n    const avgInterval = totalDuration / intervals.length;\n    const sqDiffs = intervals.map(val => Math.pow(val - avgInterval, 2));\n    const avgSqDiff = sqDiffs.reduce((sum, val) => sum + val, 0) / sqDiffs.length;\n    return {\n      fps,\n      jitterMs: Math.sqrt(avgSqDiff),\n      frameCount: ticks.length,\n      durationMs: totalDuration\n    };\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@112","pageId":"page@c9b7499a4c1ba2243f5576b3a557958e","beforeSnapshot":"before@call@377"}
