# Hash-pinned workflow artifacts must be checkout-stable across platforms (WF-C01).
# Pins in docs/plans/atlas-delivery-cycles.json are raw LF byte SHA-256 values;
# any path that can be hash-pinned must be forced to LF on checkout.
ops/workflow/** text eol=lf
docs/plans/** text eol=lf
docs/handoffs/** text eol=lf
docs/reviews/** text eol=lf
# Project agent prompts and plugins are read verbatim by OpenCode; keep them
# LF-stable too (WF-C03 integration-owned portability correction, audit F1).
.opencode/agents/** text eol=lf
.opencode/plugins/** text eol=lf
